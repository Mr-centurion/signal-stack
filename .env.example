# Signal Stack Environment Variables
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./signal_stack.db

# LLM Providers (Free Tiers)
# Set default provider: 'gemini' | 'groq'
# When 'gemini' is set, system automatically falls back to 'groq' if rate-limited or unavailable.
DEFAULT_LLM_PROVIDER=gemini

# Google Gemini API Configuration (Free tier: aistudio.google.com)
# Free-tier quotas are low and vary by model and time; observed daily limits as low as ~20 requests per model; the client rotates models and falls back to Groq on 429.
# Model rotation order: gemini-flash-lite-latest, gemini-3.1-flash-lite, gemini-3.5-flash, gemini-3.6-flash, gemini-3-flash-preview, gemini-flash-latest
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq API Configuration (Free tier: console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Reddit Settings
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Crawler Settings
USER_AGENT=SignalStackBot/1.0 (+https://github.com/signalstack/crawler-policy)
CRAWL_CONCURRENCY=3
CRAWL_DELAY_SECONDS=2.0
RESPECT_ROBOTS_TXT=true

# Signal Recency & Priority Ranking Configuration
MAX_RECENT_SIGNAL_DAYS=90
WEIGHT_RELEVANCE=0.30
WEIGHT_IMPACT=0.20
WEIGHT_URGENCY=0.15
WEIGHT_CREDIBILITY=0.15
WEIGHT_RECENCY=0.10
WEIGHT_NOVELTY=0.10

# Scheduler Settings
BRIEF_SCHEDULE_CRON="0 6 * * 1"
